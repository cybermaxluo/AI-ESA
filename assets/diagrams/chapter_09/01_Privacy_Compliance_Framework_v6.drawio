        <mxCell id="comp-title" value="隐私计划核心组件 Privacy Program Components" style="text;fontSize=32;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=middle;" parent="1" vertex="1">

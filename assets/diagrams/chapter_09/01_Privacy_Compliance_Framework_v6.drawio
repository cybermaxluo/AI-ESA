        <mxCell id="comp-col1-title" value="1. 隐私政策与通知" style="text;fontSize=18;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="120" y="550" width="380" height="24" as="geometry" />
        </mxCell>
        <mxCell id="comp-col1-items" value="• 透明隐私声明&#xa;• Cookie横幅通知&#xa;• 分层隐私通知&#xa;• 多语言支持" style="text;fontSize=14;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="120" y="582" width="380" height="102" as="geometry" />
        </mxCell>
        <mxCell id="comp-col2-title" value="2. 同意管理 CMP" style="text;fontSize=18;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="540" y="550" width="380" height="24" as="geometry" />
        </mxCell>
        <mxCell id="comp-col2-items" value="• 细粒度同意选择&#xa;• Opt-in/Opt-out&#xa;• 同意记录可审计&#xa;• OneTrust/Cookiebot" style="text;fontSize=14;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="540" y="582" width="380" height="102" as="geometry" />
        </mxCell>
        <mxCell id="comp-col3-title" value="3. 数据主体权利 DSR" style="text;fontSize=18;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="960" y="550" width="380" height="24" as="geometry" />
        </mxCell>
        <mxCell id="comp-col3-items" value="• 30天响应流程&#xa;• 身份验证机制&#xa;• 数据导出工具&#xa;• 自动化删除" style="text;fontSize=14;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="960" y="582" width="380" height="102" as="geometry" />
        </mxCell>
        <mxCell id="comp-col4-title" value="4. 影响评估 PIA/DPIA" style="text;fontSize=18;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1380" y="550" width="380" height="24" as="geometry" />
        </mxCell>
        <mxCell id="comp-col4-items" value="• 高风险处理评估&#xa;• 自动化决策评估&#xa;• 第三方处理评估&#xa;• 持续监控更新" style="text;fontSize=14;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">

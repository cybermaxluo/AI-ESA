        <mxCell id="tech-title" value="技术控制措施" style="text;fontSize=24;fontStyle=1;fontColor=#0066FF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="120" y="734" width="780" height="28" as="geometry" />
        </mxCell>
        <mxCell id="tech-items" value="1. 隐私增强技术(PETs)&#xa;   • 差分隐私/同态加密/MPC&#xa;&#xa;2. 匿名化与假名化&#xa;   • K-anonymity/L-diversity&#xa;   • 数据脱敏/去标识化&#xa;&#xa;3. 隐私设计(Privacy by Design)&#xa;   • 默认隐私/端到端保护" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">

        </mxCell>
        <mxCell id="note-col2" value="签名验证:&#xa;• Commit + Artifact 全签名&#xa;• Sigstore 生态集成&#xa;• Policy 强制执行" style="text;fontSize=18;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">

        <mxCell id="stage4-title" value="推送仓库" style="text;fontSize=22;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1175" y="220" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="stage4-content" value="私有仓库&#xa;• Harbor (CNCF)&#xa;• Nexus Repository&#xa;&#xa;访问控制&#xa;• RBAC角色授权&#xa;• 推送需MFA认证&#xa;• 拉取IP白名单&#xa;&#xa;镜像策略&#xa;• Tag不可变&#xa;• 保留策略(30天)&#xa;• 自动垃圾回收&#xa;&#xa;存储清单&#xa;• 镜像Digest&#xa;• 扫描报告" style="text;fontSize=13;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">

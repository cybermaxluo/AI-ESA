        <mxCell id="stage3-title" value="镜像签名" style="text;fontSize=22;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="835" y="220" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="stage3-content" value="签名工具&#xa;• Cosign (Sigstore)&#xa;• Notary v2&#xa;&#xa;密钥管理&#xa;• KMS (AWS/Vault)&#xa;• 私钥离线存储&#xa;• 密钥轮换策略&#xa;&#xa;签名元数据&#xa;• 构建时间戳&#xa;• Git Commit SHA&#xa;• CI Pipeline ID&#xa;&#xa;输出签名&#xa;• image.sig&#xa;• attestation.json" style="text;fontSize=13;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="780" y="290" width="240" height="490" as="geometry" />

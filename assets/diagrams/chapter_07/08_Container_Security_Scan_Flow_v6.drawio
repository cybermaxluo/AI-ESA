        <mxCell id="stage2-title" value="漏洞扫描" style="text;fontSize=22;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="495" y="220" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="stage2-content" value="扫描工具&#xa;• Trivy (Aqua)&#xa;• Grype (Anchore)&#xa;&#xa;扫描内容&#xa;• CVE漏洞 (≥7.0)&#xa;• 恶意软件/后门&#xa;• 敏感信息泄露&#xa;&#xa;策略门禁&#xa;• Critical/High=0&#xa;• Medium≤5&#xa;• 黑名单拦截&#xa;&#xa;输出报告&#xa;• SBOM (CycloneDX)&#xa;• 漏洞清单JSON" style="text;fontSize=13;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="440" y="290" width="240" height="490" as="geometry" />
        </mxCell>

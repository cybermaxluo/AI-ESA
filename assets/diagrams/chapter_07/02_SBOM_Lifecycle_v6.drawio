          <mxGeometry x="984" y="720" width="856" height="320" as="geometry" />
        </mxCell>
        <mxCell id="compliance-bg" value="" style="rounded=1;fillColor=#0066FF;strokeColor=NONE;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="976" y="720" width="854" height="310" as="geometry" />
        </mxCell>
        <mxCell id="compliance-title" value="合规要求" style="text;fontSize=24;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">
          <mxGeometry x="1024" y="730" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="compliance-items" value="1. US Executive Order 14028 (2021)&#xa;   • 联邦政府软件采购必须提供 SBOM&#xa;&#xa;2. EU Cyber Resilience Act (CRA)&#xa;   • CE 认证要求软件透明度&#xa;&#xa;3. NIST SSDF (Secure Software Development Framework)&#xa;   • PO.1: SBOM 作为软件供应链透明度基础&#xa;&#xa;4. 行业标准&#xa;   • 金融: PCI DSS 4.0 供应链要求&#xa;   • 医疗: FDA 医疗设备 SBOM 指南" style="text;fontSize=16;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=5;spacingRight=5;spacingTop=2;spacingBottom=2;" parent="1" vertex="1">

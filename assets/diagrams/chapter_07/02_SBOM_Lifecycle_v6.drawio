        <mxCell id="fmt1-title" value="SPDX (Software Package Data Exchange)" style="text;fontSize=16;fontStyle=1;fontColor=#0066FF;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="120" y="552" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fmt1-text" value="• Linux Foundation 主导 | • ISO/IEC 5962:2021 国际标准 | • 支持多种序列化格式 (JSON, XML, YAML, RDF)" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">
          <mxGeometry x="120" y="584" width="1700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fmt2-title" value="CycloneDX" style="text;fontSize=16;fontStyle=1;fontColor=#0066FF;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="990" y="552" width="120" height="28" as="geometry" />
        </mxCell>
        <mxCell id="fmt2-text" value="• OWASP 项目 | • 专注于应用安全场景 | • 支持服务 BOM (SBOM, HBOM, SaaSBOM) | • 轻量级 JSON/XML" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">
          <mxGeometry x="984" y="580" width="690" height="32" as="geometry" />
        </mxCell>

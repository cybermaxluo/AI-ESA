        <mxCell id="tracks-box" value="" style="rounded=1;fillColor=#F0F9FF;strokeColor=#0066FF;strokeWidth=2;arcSize=6;" parent="1" vertex="1">
          <mxGeometry x="80" y="570" width="1576" height="254" as="geometry" />
        </mxCell>
        <mxCell id="tracks-title" value="SLSA评估维度 (Tracks)" style="text;fontSize=24;fontStyle=1;fontColor=#0066FF;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="80" y="585" width="1560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tracks-content" value="Build Track (构建轨迹): 评估构建过程的完整性和可重现性&#xa;• L1: 脚本化构建 | L2: 构建服务 | L3: 硬化构建平台 | L4: 隔离构建环境&#xa;&#xa;Source Track (源代码轨迹): 评估源代码的可信性和可追溯性&#xa;• L1: 版本控制 | L2: 历史保留 | L3: 保留溯源 | L4: 双人审查 + 不可伪造历史" style="text;fontSize=13;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="102" y="630" width="464" height="114" as="geometry" />
        </mxCell>
        <mxCell id="footer-text" value="官方资源: slsa.dev | 工具集成: Sigstore (Cosign/Fulcio/Rekor) | in-toto (Attestation) | GUAC (图谱分析)" style="text;fontSize=16;fontColor=#0066FF;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="80" y="832" width="1560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="JAHWqRIAif0dud5sV-QG-1" value="Provenance Track (溯源轨迹): 评估溯源信息的完整性和可验证性&#xa;• L1: 可用溯源 | L2: 托管溯源 | L3: 不可伪造 | L4: 依赖完整性&#xa;&#xa;Common Requirements (通用要求): 所有等级共同遵守的安全基线&#xa;• 安全发布流程 | 事件响应计划 | 漏洞披露政策 | SBOM生成" style="text;fontSize=13;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="748" y="634" width="424" height="106" as="geometry" />
        </mxCell>

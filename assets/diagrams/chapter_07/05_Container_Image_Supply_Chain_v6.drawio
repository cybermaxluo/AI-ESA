          <mxGeometry x="976" y="624" width="856" height="160" as="geometry" />
        </mxCell>
        <mxCell id="runtime-title" value="6. 运行时保护" style="text;fontSize=24;fontStyle=1;fontColor=#0066FF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">
          <mxGeometry x="1024" y="624" width="156" height="42" as="geometry" />
        </mxCell>
        <mxCell id="runtime-items" value="Container Runtime Security:&#xa;• Falco 行为监控 (syscall anomaly)&#xa;• AppArmor / SELinux 强制访问控制&#xa;• Seccomp Profile (系统调用白名单)&#xa;• Read-only Filesystem&#xa;• Network Policy 网络隔离" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=5;spacingRight=5;spacingTop=2;spacingBottom=2;" parent="1" vertex="1">
          <mxGeometry x="1024" y="668" width="326" height="116" as="geometry" />
        </mxCell>

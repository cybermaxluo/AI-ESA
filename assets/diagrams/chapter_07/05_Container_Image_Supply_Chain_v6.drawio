        <mxCell id="deploy-title" value="5. 部署验证" style="text;fontSize=24;fontStyle=1;fontColor=#0066FF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">
          <mxGeometry x="120" y="624" width="140" height="42" as="geometry" />
        </mxCell>
        <mxCell id="deploy-items" value="Admission Webhook (K8s):&#xa;• 签名验证 (cosign verify)&#xa;• Policy 检查 (Kyverno/OPA)&#xa;• SBOM 存在性检查&#xa;• 漏洞阈值门禁 (Critical = 0)&#xa;• Image 白名单/Registry 限制" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=5;spacingRight=5;spacingTop=2;spacingBottom=2;" parent="1" vertex="1">

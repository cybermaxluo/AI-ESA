          <mxGeometry x="80" y="816" width="1756" height="140" as="geometry" />
        </mxCell>
        <mxCell id="sbom-title" value="Container SBOM (软件物料清单)" style="text;fontSize=24;fontStyle=1;fontColor=#0066FF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">
          <mxGeometry x="120" y="816" width="370" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sbom-items" value="生成工具: Syft, Tern, Anchore&#xa;格式: SPDX / CycloneDX&#xa;内容: OS packages + Application dependencies + Layer metadata&#xa;用途: 漏洞追溯 (Log4Shell 式快速定位) | License 合规 | 供应商透明度 | 事件响应" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">
          <mxGeometry x="120" y="856" width="590" height="78" as="geometry" />
        </mxCell>

          <mxGeometry x="1520" y="200" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="l4-subtitle" value="Reproducible" style="text;fontSize=16;fontColor=#FFFFFF;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="1520" y="232" width="320" height="20" as="geometry" />
        </mxCell>
        <mxCell id="l4-items" value="要求:&#xa;• 可重现构建&#xa;• 2-party 审核&#xa;&#xa;防护:&#xa;构建平台妥协" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=5;spacingRight=5;spacingTop=2;spacingBottom=2;" parent="1" vertex="1">

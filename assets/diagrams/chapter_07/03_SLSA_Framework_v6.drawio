        </mxCell>
        <mxCell id="l2-header" value="" style="rounded=1;fillColor=#0066FF;strokeColor=NONE;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="560" y="200" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l2-title" value="SLSA Level 2" style="text;fontSize=24;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="560" y="200" width="420" height="32" as="geometry" />
        </mxCell>
        <mxCell id="l2-subtitle" value="Tamper Resistance" style="text;fontSize=16;fontColor=#FFFFFF;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="560" y="232" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="l2-items" value="要求:&#xa;• 托管构建服务 (CI/CD)&#xa;• 可验证的来源签名&#xa;• 防篡改构建环境&#xa;&#xa;防护: 源码篡改后构建" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=5;spacingRight=5;spacingTop=2;spacingBottom=2;" parent="1" vertex="1">

        <mxCell id="l3-title" value="SLSA Level 3" style="text;fontSize=24;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="1040" y="200" width="420" height="32" as="geometry" />
        </mxCell>
        <mxCell id="l3-subtitle" value="Extra Hardened" style="text;fontSize=16;fontColor=#FFFFFF;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="1040" y="232" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="l3-items" value="要求:&#xa;• 审计日志 (所有构建步骤)&#xa;• 源码 + 构建平台审计&#xa;• 不可变基础设施&#xa;&#xa;防护: 特权用户攻击" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=5;spacingRight=5;spacingTop=2;spacingBottom=2;" parent="1" vertex="1">

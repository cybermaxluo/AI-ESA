        <mxCell id="service7-subtitle" value="Threat Modeling (STRIDE/PASTA) | 设计阶段" style="text;fontSize=13;fontColor=#4338CA;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="700" y="195" width="580" height="18" as="geometry" />
        </mxCell>
        <mxCell id="service7-content" value="服务内容&#xa;• STRIDE/PASTA威胁分析&#xa;• 数据流图(DFD)分析&#xa;• 攻击面评估与建模&#xa;• 安全控制设计建议&#xa;&#xa;SLA: 重大项目5-10个工作日(P1/P2)&#xa;输出: 威胁模型文档、风险清单、控制建议" style="text;fontSize=13;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=4;" parent="1" vertex="1">

        <mxCell id="service7-title" value="7. 威胁建模 (P0)" style="text;fontSize=20;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="700" y="130" width="580" height="55" as="geometry" />

        <mxCell id="service5-title" value="5. 发布/变更评审" style="text;fontSize=20;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="80" y="680" width="580" height="55" as="geometry" />

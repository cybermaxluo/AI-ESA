          <mxGeometry x="1320" y="680" width="580" height="248" as="geometry" />
        </mxCell>
        <mxCell id="service9-header" value="" style="rounded=1;fillColor=#DC2626;strokeColor=none;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="1320" y="680" width="580" height="55" as="geometry" />
        </mxCell>
        <mxCell id="service9-title" value="9. 漏洞管理服务 (P1)" style="text;fontSize=20;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1320" y="680" width="580" height="55" as="geometry" />
        </mxCell>
        <mxCell id="service9-subtitle" value="Vulnerability Management (SRC/Bug Bounty) | 运营阶段" style="text;fontSize=13;fontColor=#7F1D1D;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="1320" y="745" width="580" height="18" as="geometry" />
        </mxCell>
        <mxCell id="service9-content" value="服务内容&#xa;• 内部漏洞协调(SRC)&#xa;• 漏洞赏金运营(Bug Bounty)&#xa;• 漏洞披露政策(VDP)响应&#xa;• 漏洞奖励计划管理&#xa;&#xa;SLA: 严重1天/高危3天/中危14天/低危30天&#xa;输出: 漏洞响应报告、修复验证、奖励发放" style="text;fontSize=13;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="1340" y="770" width="540" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sla-box" value="" style="rounded=1;fillColor=#EEF2FF;strokeColor=none;strokeWidth=2;arcSize=6;" parent="1" vertex="1">
          <mxGeometry x="72" y="952" width="1824" height="212" as="geometry" />
        </mxCell>
        <mxCell id="sla-title" value="服务受理与优先级管理" style="text;fontSize=22;fontStyle=1;fontColor=#0066FF;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="72" y="967" width="1820" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sla-content" value="单一入口: 内网工单系统(分类:威胁建模/代码审计/测试/发布/应急/供应链/培训/漏洞管理/咨询等)&#xa;&#xa;优先级定义:&#xa;• P1=影响生产核心交易/合规时限 (最高优先级,立即响应) | 应用场景: 应急响应、漏洞管理、发布评审&#xa;• P2=临近上线关键里程碑 (高优先级,2-5个工作日) | 应用场景: 威胁建模、代码审计、安全测试、培训&#xa;• P3=常规需求 (标准优先级,按排期协商) | 应用场景: 供应链评估、移动逆向、安全咨询&#xa;&#xa;沟通渠道: 工单+IM群+邮件 | 重要节点使用会议纪要与总结报告" style="text;fontSize=13;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="112" y="1007" width="1736" height="125" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="" style="rounded=1;fillColor=#F3F4F6;strokeColor=none;arcSize=6;" parent="1" vertex="1">

        </mxCell>
        <mxCell id="service8-title" value="8. 代码审计/安全评审 (P0)" style="text;fontSize=20;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1320" y="130" width="580" height="55" as="geometry" />
        </mxCell>
        <mxCell id="service8-subtitle" value="Code Review / Security Design Review | 开发阶段" style="text;fontSize=13;fontColor=#115E59;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="1320" y="195" width="580" height="18" as="geometry" />
        </mxCell>
        <mxCell id="service8-content" value="服务内容&#xa;• 安全架构设计评审(SDR)&#xa;• 关键代码人工审计&#xa;• 加密/认证实现审查&#xa;• 权限控制逻辑验证&#xa;&#xa;SLA: P1项目2天/P2项目5天&#xa;输出: 评审报告、代码加固建议、门禁配置" style="text;fontSize=13;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=4;" parent="1" vertex="1">

        </mxCell>
        <mxCell id="footer-text" value="联系方式: appsec@company.com | 工单系统: https://security.company.com/tickets | 文档: https://wiki.company.com/security/appsec" style="text;fontSize=15;fontColor=#6B7280;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="72" y="1188" width="1820" height="50" as="geometry" />

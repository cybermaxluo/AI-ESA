        <mxCell id="service6-title" value="6. 应急响应" style="text;fontSize=20;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="700" y="680" width="580" height="55" as="geometry" />
        </mxCell>
        <mxCell id="service6-subtitle" value="DFIR (Digital Forensics &amp; Incident Response) | 运营阶段" style="text;fontSize=13;fontColor=#991B1B;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="700" y="745" width="580" height="18" as="geometry" />
        </mxCell>
        <mxCell id="service6-content" value="响应流程&#xa;• 事件检测与遏制&#xa;• 数字取证分析&#xa;• 根因分析与整改&#xa;• 事后复盘与总结&#xa;&#xa;SLA: 严重1h/高危2h/中危4h/低危8h&#xa;输出: 应急报告、整改措施、复盘总结" style="text;fontSize=13;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="720" y="770" width="540" height="95" as="geometry" />

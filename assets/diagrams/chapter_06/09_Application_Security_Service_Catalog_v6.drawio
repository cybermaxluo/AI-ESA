        <mxCell id="service5-subtitle" value="Release &amp; Change Review | 发布阶段" style="text;fontSize=13;fontColor=#831843;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="80" y="745" width="580" height="18" as="geometry" />
        </mxCell>
        <mxCell id="service5-content" value="评审内容&#xa;• 变更单审查&#xa;• 安全评估结果验证&#xa;• 回滚预案审核&#xa;• 质量门禁检查&#xa;&#xa;SLA: 当日窗口(P1)&#xa;输出: 放行/阻断结论、风险建议" style="text;fontSize=13;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=4;" parent="1" vertex="1">

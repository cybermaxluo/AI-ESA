        <mxCell id="orch1-title" value="1. 扫描编排" style="text;fontSize=15;fontStyle=1;fontColor=#3B82F6;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="120" y="460" width="360" height="22" as="geometry" />
        </mxCell>
        <mxCell id="orch1-content" value="• DefectDojo: 漏洞聚合管理&#xa;• Nuclei: 自定义扫描模板&#xa;• GitHub Actions/GitLab CI: 流水线集成&#xa;• Jenkins X: Kubernetes 原生 CI/CD" style="text;fontSize=12;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=3;" parent="1" vertex="1">
          <mxGeometry x="120" y="490" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="orch2-box" value="" style="rounded=1;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=1;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="540" y="450" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="orch2-title" value="2. 结果归一化" style="text;fontSize=15;fontStyle=1;fontColor=#10B981;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="560" y="460" width="360" height="22" as="geometry" />
        </mxCell>
        <mxCell id="orch2-content" value="• SARIF 格式 (Static Analysis Results)&#xa;• CycloneDX/SPDX (SBOM)&#xa;• CVE/CWE 映射&#xa;• 统一严重度评分 (CVSS 3.1)" style="text;fontSize=12;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=3;" parent="1" vertex="1">
          <mxGeometry x="560" y="490" width="360" height="80" as="geometry" />
        </mxCell>

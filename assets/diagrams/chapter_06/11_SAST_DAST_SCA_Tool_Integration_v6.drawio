          <mxGeometry x="980" y="450" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="orch3-title" value="3. 质量门禁" style="text;fontSize=15;fontStyle=1;fontColor=#F59E0B;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="1000" y="460" width="360" height="22" as="geometry" />
        </mxCell>
        <mxCell id="orch3-content" value="• Critical/High 漏洞阻止发布&#xa;• SLA 合规检查 (如: 修复时限)&#xa;• 策略引擎: OPA/Kyverno&#xa;• 审批流程: Jira/ServiceNow 集成" style="text;fontSize=12;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=3;" parent="1" vertex="1">

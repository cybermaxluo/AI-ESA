        <mxCell id="bp-col1" value="认证授权:&#xa;• 使用标准协议 (OAuth 2.0)&#xa;• JWT 签名验证&#xa;• 短期 Token + Refresh&#xa;• API Key 轮换机制" style="text;fontSize=16;fontColor=#999999;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=5;spacingRight=5;spacingTop=2;spacingBottom=2;" parent="1" vertex="1">
          <mxGeometry x="120" y="872" width="400" height="108" as="geometry" />
        </mxCell>
        <mxCell id="bp-col2" value="输入验证:&#xa;• OpenAPI Schema 校验&#xa;• 白名单过滤&#xa;• 参数类型/长度检查&#xa;• 防止注入攻击" style="text;fontSize=16;fontColor=#999999;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=5;spacingRight=5;spacingTop=2;spacingBottom=2;" parent="1" vertex="1">

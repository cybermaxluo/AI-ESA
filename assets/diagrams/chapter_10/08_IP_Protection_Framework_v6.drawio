        <mxCell id="license" value="许可证管理&#xa;────────&#xa;• MIT/Apache允许&#xa;• LGPL谨慎使用&#xa;• GPL禁止(传染)&#xa;• AGPL网络风险" style="rounded=1;fillColor=#F8F9FF;strokeColor=#0066FF;strokeWidth=2;arcSize=16;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=center;spacing=10;" parent="1" vertex="1">

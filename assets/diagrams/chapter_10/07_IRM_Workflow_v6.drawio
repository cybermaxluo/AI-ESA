        <mxCell id="step1-number" value="1" style="ellipse;fillColor=#FFFFFF;strokeColor=NONE;fontSize=24;fontStyle=1;fontColor=#0066FF;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="100" y="195" width="30" height="30" as="geometry" />

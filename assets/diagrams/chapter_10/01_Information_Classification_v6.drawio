        <mxCell id="title" value="信息分类分级体系" style="text;fontSize=48;fontStyle=1;fontColor=#0066FF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">
          <mxGeometry x="80" y="48" width="800" height="120" as="geometry" />

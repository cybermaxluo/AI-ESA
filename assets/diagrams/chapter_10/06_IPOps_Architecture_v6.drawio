        <mxCell id="kpi-subtitle" value="Key Performance Indicators Dashboard" style="text;fontSize=14;fontColor=#6B7280;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="120" y="800" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="kpi-content" value="覆盖率指标:&#xa;• 分类覆盖率 &gt;90%&#xa;• DLP策略覆盖 &gt;95%&#xa;• IRM保护比例 &gt;80%&#xa;&#xa;有效性指标:&#xa;• DLP阻止率 &gt;80%&#xa;• 误报率 &lt;10%&#xa;• 真实事件价值 $50K-500K&#xa;&#xa;效率指标:&#xa;• MTTR &lt;15分钟(Critical)&#xa;• MTTC &lt;4小时(平均)&#xa;• 自动化率 &gt;40%" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=10;spacingTop=5;" parent="1" vertex="1">
          <mxGeometry x="170" y="827.5" width="200" height="255" as="geometry" />
        </mxCell>
        <mxCell id="kpi-metrics" value="用户影响:&#xa;• 用户满意度 &gt;4.0&#xa;• 分类准确率 &gt;85%&#xa;• Help Desk工单 ↓&#xa;&#xa;合规指标:&#xa;• 审计发现 0 Critical&#xa;• 策略豁免率 &lt;5%&#xa;&#xa;趋势分析:&#xa;• 月度事件趋势&#xa;• 同行基准对比&#xa;• 投资回报ROI" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=10;spacingTop=5;" parent="1" vertex="1">

          <mxGeometry x="1016" y="800" width="500" height="20" as="geometry" />
        </mxCell>
        <mxCell id="siem-data-sources" value="数据源整合:&#xa;• DLP事件日志 (高危下载/上传)&#xa;• IRM访问审计 (文档打开/撤销)&#xa;• CASB云应用活动 (Shadow IT)&#xa;• UEBA用户风险评分&#xa;• 端点DLP (离线数据)&#xa;&#xa;关联规则:&#xa;• DLP大量下载 + UEBA高风险 = Critical&#xa;• 离职员工 + 异常访问 = 内部威胁&#xa;• 外部分享 + 异常位置 = 数据泄漏" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=10;spacingTop=5;" parent="1" vertex="1">
          <mxGeometry x="1016" y="830" width="324" height="220" as="geometry" />
        </mxCell>
        <mxCell id="siem-response" value="自动化响应:&#xa;• SOAR Playbook 执行&#xa;• 自动暂停账户&#xa;• 工单自动创建&#xa;• 告警升级通知&#xa;&#xa;输出集成:&#xa;• Splunk/Sentinel&#xa;• ServiceNow/Jira&#xa;• HR系统同步&#xa;• 邮件/Teams通知" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=10;spacingTop=5;" parent="1" vertex="1">

        <mxCell id="stage3-num" value="3" style="ellipse;fillColor=#FFFFFF;strokeColor=NONE;fontColor=#0066FF;fontSize=36;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="896" y="208" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="stage3-title" value="共享 Sharing" style="text;fontSize=24;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">
          <mxGeometry x="960" y="208" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stage3-items" value="• 动态权限控制&#xa;  - View Only / Edit / Print&#xa;• 过期时间设置&#xa;• 水印嵌入 (动态/静态)&#xa;• 外部共享审批&#xa;• DLP 扫描检查&#xa;• 安全链接生成" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=5;spacingRight=5;spacingTop=2;spacingBottom=2;" parent="1" vertex="1">
          <mxGeometry x="896" y="270" width="328" height="140" as="geometry" />
        </mxCell>

        <mxCell id="stage2-title" value="存储 Storage" style="text;fontSize=24;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">
          <mxGeometry x="560" y="208" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stage2-items" value="• 加密存储 (AES-256)&#xa;• 访问控制 (RBAC)&#xa;• 版本控制&#xa;• 备份保护&#xa;• 索引加密&#xa;• 位置限制 (地理围栏)" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=5;spacingRight=5;spacingTop=2;spacingBottom=2;" parent="1" vertex="1">

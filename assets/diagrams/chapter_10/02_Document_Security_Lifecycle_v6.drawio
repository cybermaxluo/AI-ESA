        <mxCell id="stage4-title" value="使用 Usage" style="text;fontSize=24;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">
          <mxGeometry x="1360" y="208" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stage4-items" value="• 实时权限验证&#xa;• 操作审计&#xa;  - Open, View, Edit&#xa;  - Print, Copy&#xa;• 离线访问控制&#xa;• 截屏防护&#xa;• 地理位置验证" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=5;spacingRight=5;spacingTop=2;spacingBottom=2;" parent="1" vertex="1">
          <mxGeometry x="1296" y="270" width="248" height="140" as="geometry" />
        </mxCell>

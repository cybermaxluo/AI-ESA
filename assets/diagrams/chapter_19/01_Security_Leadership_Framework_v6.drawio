        <mxCell id="8Zvqa6o8Ak2jmX3WFNl9-1" value="年度规划:&#xa;• Roadmap 对齐业务优先级&#xa;• 投资组合管理 (Portfolio)&#xa;• OKR 设定与追踪" style="text;fontSize=15;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1">

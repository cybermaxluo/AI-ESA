          <mxGeometry x="1604" y="244" width="700" height="380" as="geometry" />
        </mxCell>
        <mxCell id="p3-bg" value="" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E0E7FF;strokeWidth=3;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="1600" y="240" width="700" height="380" as="geometry" />

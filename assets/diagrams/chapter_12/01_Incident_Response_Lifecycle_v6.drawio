        </mxCell>
        <mxCell id="p1-content" value="关键活动:&#xa;• 制定应急响应计划 (IRP)&#xa;• 组建 CSIRT 团队&#xa;• 部署监控工具 (SIEM/EDR/NDR)&#xa;• 建立通信渠道 (War Room)&#xa;• 准备取证工具包&#xa;• 定期演练 (Tabletop Exercise)" style="text;fontSize=16;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="104" y="360" width="270" height="180" as="geometry" />
        </mxCell>

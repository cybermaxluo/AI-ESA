        <mxCell id="p2-num" value="2" style="text;fontSize=40;fontStyle=1;fontColor=#0066FF;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="870" y="260" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-title-cn" value="检测与分析" style="text;fontSize=32;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="950" y="260" width="280" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p2-title-en" value="Detection &amp; Analysis" style="text;fontSize=18;fontColor=#FFFFFF;fontFamily=Inter;align=left;opacity=90;" parent="1" vertex="1">
          <mxGeometry x="950" y="300" width="280" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p2-content" value="检测来源:&#xa;• SIEM 告警 (规则触发)&#xa;• EDR 异常行为 | 用户报告&#xa;• 第三方通知 (安全厂商/客户)&#xa;&#xa;初步分析:&#xa;• 事件分类 (True/False Positive)&#xa;• 严重性评级 (Critical/High/Medium/Low)&#xa;• 影响范围评估 (受影响资产)&#xa;• 时间线构建 (事件起点)&#xa;&#xa;升级决策: L1 → L2 → L3 → CSIRT Manager&#xa;文档: 初始事件报告 (Initial Incident Report)" style="text;fontSize=16;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="868" y="350" width="350" height="260" as="geometry" />
        </mxCell>

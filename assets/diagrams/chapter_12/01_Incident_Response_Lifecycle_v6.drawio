          <mxGeometry x="80" y="1136" width="1080" height="460" as="geometry" />
        </mxCell>
        <mxCell id="sev-title" value="严重性分级 Severity Classification" style="text;fontSize=28;fontStyle=1;fontColor=#0066FF;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="130" y="1176" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sev-p0-label" value="Critical (P0 - 1小时响应):" style="text;fontSize=18;fontStyle=1;fontColor=#DC2626;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="130" y="1236" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="sev-p0-desc" value="• 核心业务中断 | 大规模数据泄露 | 勒索软件加密 | APT 入侵" style="text;fontSize=16;fontColor=#1A1A1A;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="130" y="1266" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sev-p1-label" value="High (P1 - 4小时响应):" style="text;fontSize=18;fontStyle=1;fontColor=#EA580C;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="130" y="1316" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="sev-p1-desc" value="• 部分系统受损 | 敏感数据访问 | 特权账户被盗" style="text;fontSize=16;fontColor=#1A1A1A;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="130" y="1346" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sev-p2-label" value="Medium (P2 - 24小时响应):" style="text;fontSize=18;fontStyle=1;fontColor=#F59E0B;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="130" y="1396" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="sev-p2-desc" value="• 单个主机感染 | 钓鱼邮件点击 | 非关键系统漏洞" style="text;fontSize=16;fontColor=#1A1A1A;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="130" y="1426" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sev-p3-label" value="Low (P3 - 72小时响应):" style="text;fontSize=18;fontStyle=1;fontColor=#10B981;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="130" y="1476" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="sev-p3-desc" value="• 策略违规 | 误报确认 | 安全配置问题" style="text;fontSize=16;fontColor=#1A1A1A;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="130" y="1506" width="1000" height="60" as="geometry" />

          <mxGeometry x="1630" y="260" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3-title-cn" value="遏制" style="text;fontSize=32;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="1710" y="260" width="200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p3-title-en" value="Containment" style="text;fontSize=18;fontColor=#FFFFFF;fontFamily=Inter;align=left;opacity=90;" parent="1" vertex="1">
          <mxGeometry x="1710" y="300" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3-content" value="短期遏制:&#xa;• 隔离受感染主机 | 阻断恶意 IP/域名&#xa;• 禁用受损账户 | 断开网络连接&#xa;&#xa;长期遏制:&#xa;• 打补丁修复漏洞 | 重置所有密码&#xa;• 部署临时防护规则 | 加强监控&#xa;" style="text;fontSize=16;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="1630" y="348" width="280" height="170" as="geometry" />
        </mxCell>

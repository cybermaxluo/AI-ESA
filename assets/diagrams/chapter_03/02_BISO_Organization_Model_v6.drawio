        </mxCell>

        <mxCell id="model1-scenario" value="[适用] 创业公司(100-500人)" style="text;fontSize=14;fontColor=#6B7280;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" vertex="1" parent="1">
          <mxGeometry x="112" y="372" width="480" height="24" as="geometry" />
        </mxCell>

        <mxCell id="model1-pros-cons" value="[✓] 易管理、成本低  [✗] 响应慢" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" vertex="1" parent="1">

          <mxGeometry x="1810" y="730" width="480" height="26" as="geometry" />
        </mxCell>
        <mxCell id="tech4-items" value="• 威胁情报摘要生成&#xa;• SOC 分析师助手 (Copilot)&#xa;• 事件报告自动生成&#xa;• 安全策略代码生成" style="text;fontSize=15;fontColor=#FFFFFF;fontFamily=Inter;align=left;verticalAlign=top;spacing=2;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="1810" y="760" width="480" height="72" as="geometry" />

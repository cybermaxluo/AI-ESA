        <!-- 监督学习 -->
        <mxCell id="tech1-title" value="监督学习 Supervised" style="text;fontSize=18;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="130" y="730" width="500" height="26" as="geometry" />
        </mxCell>
        <mxCell id="tech1-items" value="• 恶意软件分类 (Random Forest, XGBoost)&#xa;• 钓鱼URL检测 (CNN)&#xa;• DGA域名识别 (LSTM)&#xa;• 需要标注数据集" style="text;fontSize=15;fontColor=#FFFFFF;fontFamily=Inter;align=left;verticalAlign=top;spacing=2;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="130" y="760" width="500" height="72" as="geometry" />
        </mxCell>

        <!-- 无监督学习 -->
        <mxCell id="tech2-title" value="无监督学习 Unsupervised" style="text;fontSize=18;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="690" y="730" width="500" height="26" as="geometry" />
        </mxCell>
        <mxCell id="tech2-items" value="• 异常流量检测 (Isolation Forest, Autoencoder)&#xa;• 用户行为基线 (K-Means, DBSCAN)&#xa;• 未知威胁发现&#xa;• 无需标注,自动学习正常模式" style="text;fontSize=15;fontColor=#FFFFFF;fontFamily=Inter;align=left;verticalAlign=top;spacing=2;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="690" y="760" width="500" height="72" as="geometry" />
        </mxCell>

        <!-- 深度学习 -->

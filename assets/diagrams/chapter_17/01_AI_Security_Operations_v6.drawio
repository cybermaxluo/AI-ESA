        </mxCell>
        <mxCell id="bp1-content" value="• 告警去重 (立竿见影) | 钓鱼邮件检测 (数据充足)&#xa;• 避免从复杂 APT 检测入手" style="text;fontSize=15;fontColor=#1A1A1A;fontFamily=Inter;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="1262" y="1072" width="1000" height="38" as="geometry" />
        </mxCell>

        <mxCell id="bp2-title" value="2. 人机协同 (Human-in-the-Loop)" style="text;fontSize=16;fontStyle=1;fontColor=#1A1A1A;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="1262" y="1120" width="1000" height="22" as="geometry" />

          <mxGeometry x="1250" y="730" width="500" height="26" as="geometry" />
        </mxCell>
        <mxCell id="tech3-items" value="• 恶意代码语义分析 (Transformer)&#xa;• 网络流量模式识别 (RNN/GRU)&#xa;• 图像验证码识别 (ResNet)&#xa;• 高精度但需大量算力" style="text;fontSize=15;fontColor=#FFFFFF;fontFamily=Inter;align=left;verticalAlign=top;spacing=2;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="1250" y="760" width="500" height="72" as="geometry" />
        </mxCell>

        <!-- 大语言模型 -->

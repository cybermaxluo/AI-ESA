        </mxCell>

        <mxCell id="p2-desc" value="多层安全控制,单层失效不导致&#xa;整体崩溃,增强系统韧性" style="text;fontSize=15;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacing=6;" parent="1" vertex="1">

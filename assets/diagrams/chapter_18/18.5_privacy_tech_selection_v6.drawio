        <mxCell id="rec-dp" value="推荐" style="rounded=20;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=none;fontSize=10;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;" parent="1" vertex="1">
          <mxGeometry x="580" y="185" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="rec-default" value="默认" style="rounded=20;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=none;fontSize=10;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;" parent="1" vertex="1">

          <mxGeometry x="1230" y="730" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d3-title" value="输出验证 Output Layer" style="text;fontSize=18;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="1285" y="738" width="445" height="24" as="geometry" />
        </mxCell>
        <mxCell id="d3-items" value="1) PII/敏感信息检测与脱敏&#xa;2) 有害内容过滤 (暴力/仇恨/NSFW)&#xa;3) 幻觉检测 (事实核查)&#xa;4) 输出审计日志&#xa;5) 人工审核队列 (高风险响应)&#xa;6) Watermarking (AI生成内容标记)&#xa;7) 工具: Microsoft Azure AI Content Safety" style="text;fontSize=15;fontColor=#FFFFFF;fontFamily=Inter;align=left;verticalAlign=top;spacing=2;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="1230" y="788" width="340" height="142" as="geometry" />

          <mxGeometry x="680" y="730" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d2-title" value="模型层 Model Layer" style="text;fontSize=18;fontStyle=1;fontColor=#FFFFFF;fontFamily=Inter;align=left;" parent="1" vertex="1">
          <mxGeometry x="735" y="738" width="445" height="24" as="geometry" />
        </mxCell>
        <mxCell id="d2-items" value="1) System Prompt 加固 (特权分离)&#xa;2) Fine-tuning 安全审查&#xa;3) 模型行为监控 (异常响应检测)&#xa;4) Model Versioning (回滚能力)&#xa;5) RAG 数据源验证&#xa;6) Guardrails (护栏,限制模型行为)&#xa;7) 工具: NeMo Guardrails, Guardrails AI" style="text;fontSize=15;fontColor=#FFFFFF;fontFamily=Inter;align=left;verticalAlign=top;spacing=2;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="680" y="785" width="340" height="140" as="geometry" />

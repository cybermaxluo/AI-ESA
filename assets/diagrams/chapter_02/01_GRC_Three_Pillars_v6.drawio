        </mxCell>
        <mxCell id="pillar2-content1" value="量化不确定性,优化资源配置&#xa;基于风险偏好制定处置策略&#xa;持续监控与动态调整" style="text;fontSize=16;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">

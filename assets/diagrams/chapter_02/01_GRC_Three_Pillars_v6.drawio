        <mxCell id="pillar1-content1" value="明确企业战略方向与安全目标&#xa;建立决策机制与责任体系&#xa;确保GRC活动与业务目标对齐" style="text;fontSize=16;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;" parent="1" vertex="1">

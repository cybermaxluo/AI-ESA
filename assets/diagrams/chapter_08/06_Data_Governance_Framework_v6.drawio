          <mxGeometry x="544" y="476" width="400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="org-col2-items" value="职责:&#xa;• 数据分类定级&#xa;• 访问权限审批&#xa;• 合规性负责" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">

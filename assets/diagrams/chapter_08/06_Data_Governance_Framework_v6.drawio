        <mxCell id="org-col4-items" value="职责:&#xa;• 合规使用数据&#xa;• 异常报告&#xa;• 隐私保护" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">

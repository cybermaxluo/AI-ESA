        <mxCell id="org-col1-items" value="职责:&#xa;• 数据战略制定&#xa;• 治理框架设计&#xa;• 跨部门协调" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">

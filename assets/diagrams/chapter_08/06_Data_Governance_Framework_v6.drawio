        <mxCell id="comp4-content" value="阶段&#xa;• Create/Store/Use&#xa;• Archive/Destroy&#xa;&#xa;策略&#xa;• 保留期限规则&#xa;• 自动归档/合规销毁&#xa;&#xa;标准: ISO 27001" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">

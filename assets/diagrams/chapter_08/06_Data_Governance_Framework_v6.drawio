        <mxCell id="policy-number" value="5" style="ellipse;fillColor=#FFFFFF;strokeColor=none;fontColor=#0066FF;fontSize=32;fontStyle=1;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">

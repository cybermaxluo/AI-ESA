        <mxCell id="org-col3-items" value="职责:&#xa;• 日常质量管理&#xa;• 元数据维护&#xa;• 用户支持" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">

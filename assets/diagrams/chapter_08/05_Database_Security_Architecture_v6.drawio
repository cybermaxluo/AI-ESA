        <mxCell id="threats-number" value="5" style="ellipse;fillColor=#FFFFFF;strokeColor=none;fontColor=#0066FF;fontSize=32;fontStyle=1;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="96" y="595" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="threats-title" value="常见威胁与控制措施 Common Threats &amp; Controls" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="156" y="602" width="1600" height="44" as="geometry" />
        </mxCell>
        <mxCell id="threat1-title" value="SQL注入攻击" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#999999;align=left;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="112" y="668" width="400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="threat1-content" value="控制措施:&#xa;• 使用参数化查询/预编译语句&#xa;• 输入验证与过滤&#xa;• 部署WAF与DAM实时监控&#xa;• 最小权限原则" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="112" y="696" width="400" height="96" as="geometry" />
        </mxCell>
        <mxCell id="threat2-title" value="越权访问" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#999999;align=left;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="544" y="668" width="400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="threat2-content" value="控制措施:&#xa;• 严格的RBAC权限管理&#xa;• 行级安全策略(RLS)&#xa;• 定期权限审计&#xa;• 账号权限最小化" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="544" y="696" width="400" height="96" as="geometry" />
        </mxCell>
        <mxCell id="threat3-title" value="数据泄露" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#999999;align=left;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="976" y="668" width="400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="threat3-content" value="控制措施:&#xa;• 静态与传输加密(TDE + TLS)&#xa;• 数据脱敏与掩码&#xa;• DLP数据防泄漏系统&#xa;• 访问日志审计" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="976" y="696" width="400" height="96" as="geometry" />
        </mxCell>
        <mxCell id="threat4-title" value="内部威胁" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#999999;align=left;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="1408" y="668" width="400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="threat4-content" value="控制措施:&#xa;• PAM特权访问管理&#xa;• 会话录制与回放&#xa;• 行为基线与异常检测&#xa;• 职责分离(SoD)" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="1408" y="696" width="400" height="96" as="geometry" />
        </mxCell>
        <mxCell id="threat5-title" value="勒索软件/数据破坏" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#999999;align=left;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="112" y="816" width="400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="threat5-content" value="控制措施:&#xa;• 自动化备份与异地存储&#xa;• 备份加密与不可变存储&#xa;• 快速恢复演练(RTO &lt; 4h)&#xa;• 网络隔离与访问控制" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="112" y="844" width="400" height="96" as="geometry" />
        </mxCell>
        <mxCell id="threat6-title" value="配置错误与漏洞" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#999999;align=left;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="544" y="816" width="400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="threat6-content" value="控制措施:&#xa;• 安全基线与配置管理(CIS Benchmark)&#xa;• 自动化漏洞扫描&#xa;• 及时补丁更新&#xa;• 定期安全评估" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="544" y="844" width="400" height="96" as="geometry" />
        </mxCell>
        <mxCell id="threat7-title" value="合规性违规" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#999999;align=left;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="976" y="816" width="400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="threat7-content" value="控制措施:&#xa;• 完整的审计日志(GDPR/PCI DSS)&#xa;• 数据分类与标签&#xa;• 定期合规性审计&#xa;• 隐私影响评估(PIA)" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="976" y="844" width="400" height="96" as="geometry" />
        </mxCell>
        <mxCell id="threat8-title" value="拒绝服务攻击(DoS/DDoS)" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#999999;align=left;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="1408" y="816" width="400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="threat8-content" value="控制措施:&#xa;• 连接限速与资源配额&#xa;• 查询复杂度限制&#xa;• 数据库防火墙&#xa;• 高可用架构(主从/集群)" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="1408" y="844" width="400" height="96" as="geometry" />
        </mxCell>
      </root>

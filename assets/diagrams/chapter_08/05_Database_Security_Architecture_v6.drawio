        <mxCell id="layer1-item1-content" value="• 多因素认证(MFA)&#xa;• Kerberos/LDAP集成&#xa;• 证书认证" style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=top;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;spacing=4;" parent="1" vertex="1">

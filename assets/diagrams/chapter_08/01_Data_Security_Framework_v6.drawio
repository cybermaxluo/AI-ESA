        <mxCell id="gov-title" value="数据治理基础 Data Governance Foundation" style="text;fontSize=24;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="120" y="866" width="1680" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gov-items" value="数据目录 | 数据血缘 | 数据质量 | 元数据管理 | 数据所有权 | 生命周期策略 | 留存与销毁 | 跨境传输管理 | 隐私影响评估 (PIA)" style="text;fontSize=14;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=middle;opacity=90;" parent="1" vertex="1">
          <mxGeometry x="120" y="904" width="1680" height="26" as="geometry" />

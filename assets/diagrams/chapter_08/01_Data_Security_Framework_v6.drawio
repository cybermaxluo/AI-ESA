          <mxGeometry x="80" y="170" width="1756" height="140" as="geometry" />
        </mxCell>
        <mxCell id="stage1-header" value="" style="rounded=1;fillColor=#0066FF;strokeColor=none;arcSize=12;rounded=1;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="80" y="170" width="1756" height="56" as="geometry" />
        </mxCell>
        <mxCell id="stage1-number" value="1" style="ellipse;fillColor=#FFFFFF;strokeColor=none;fontColor=#0066FF;fontSize=32;fontStyle=1;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="96" y="176" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="stage1-title" value="数据发现" style="text;fontSize=28;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="156" y="176" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="stage1-title-en" value="Data Discovery" style="text;fontSize=16;fontColor=#E0E7FF;fontFamily=Inter;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="370" y="184" width="200" height="28" as="geometry" />
        </mxCell>

        <mxCell id="stage1-col1" value="结构化数据:\n• 数据库扫描 (RDBMS)\n• Data Lake / Warehouse" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="120" y="242" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="stage1-col2" value="非结构化数据:\n• 文件服务器\n• SharePoint / Confluence" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="540" y="242" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="stage1-col3" value="云数据:\n• S3 / Blob Storage\n• SaaS 应用 (Salesforce)" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="960" y="242" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="stage1-col4" value="工具:\n• BigID / OneTrust\n• Microsoft Purview" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1380" y="242" width="380" height="58" as="geometry" />
        </mxCell>

        <!-- Stage 2: Data Classification -->
        <mxCell id="stage2-shadow" value="" style="rounded=1;fillColor=#E5E7EB;strokeColor=none;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="84" y="338" width="1756" height="160" as="geometry" />
        </mxCell>
        <mxCell id="stage2-bg" value="" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E0E7FF;strokeWidth=2;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="80" y="334" width="1756" height="160" as="geometry" />
        </mxCell>
        <mxCell id="stage2-header" value="" style="rounded=1;fillColor=#0066FF;strokeColor=none;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="80" y="334" width="1756" height="56" as="geometry" />

        <mxCell id="stage2-number" value="2" style="ellipse;fillColor=#FFFFFF;strokeColor=none;fontColor=#0066FF;fontSize=32;fontStyle=1;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="96" y="340" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="stage2-title" value="数据分类" style="text;fontSize=28;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="156" y="340" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="stage2-title-en" value="Data Classification" style="text;fontSize=16;fontColor=#E0E7FF;fontFamily=Inter;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="370" y="348" width="240" height="28" as="geometry" />
        </mxCell>

        <mxCell id="stage2-col1" value="敏感度级别:\n• Public (公开)\n• Internal (内部)\n• Confidential (机密)\n• Restricted (绝密)" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="120" y="406" width="380" height="78" as="geometry" />
        </mxCell>
        <mxCell id="stage2-col2" value="数据类型:\n• PII (个人身份信息)\n• PHI (健康信息)\n• PCI (支付卡信息)\n• IP (知识产权)" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="540" y="406" width="380" height="78" as="geometry" />
        </mxCell>
        <mxCell id="stage2-col3" value="分类方法:\n• 自动化 (ML/NLP)\n• 规则引擎 (正则)\n• 人工标注" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="960" y="406" width="380" height="78" as="geometry" />
        </mxCell>
        <mxCell id="stage2-col4" value="标签体系:\n• 元数据标签\n• 水印/标记\n• 加密标识" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1380" y="406" width="380" height="78" as="geometry" />
        </mxCell>

        <!-- Stage 3: Data Protection -->
        <mxCell id="stage3-shadow" value="" style="rounded=1;fillColor=#E5E7EB;strokeColor=none;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="84" y="522" width="1756" height="140" as="geometry" />
        </mxCell>
        <mxCell id="stage3-bg" value="" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E0E7FF;strokeWidth=2;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="80" y="518" width="1756" height="140" as="geometry" />
        </mxCell>
        <mxCell id="stage3-header" value="" style="rounded=1;fillColor=#0066FF;strokeColor=none;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="80" y="518" width="1756" height="56" as="geometry" />
        </mxCell>
        <mxCell id="stage3-number" value="3" style="ellipse;fillColor=#FFFFFF;strokeColor=none;fontColor=#0066FF;fontSize=32;fontStyle=1;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="96" y="524" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="stage3-title" value="数据保护" style="text;fontSize=28;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="156" y="524" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="stage3-title-en" value="Data Protection" style="text;fontSize=16;fontColor=#E0E7FF;fontFamily=Inter;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="370" y="532" width="200" height="28" as="geometry" />
        </mxCell>

        <mxCell id="stage3-col1" value="加密保护:\n• 传输加密 (TLS 1.3)\n• 存储加密 (AES-256)\n• 端到端加密" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="120" y="590" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="stage3-col2" value="访问控制:\n• RBAC / ABAC\n• 最小权限原则\n• JIT (即时访问)" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="540" y="590" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="stage3-col3" value="DLP 防护:\n• 网络 DLP\n• 终端 DLP\n• 云 DLP (CASB)" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="960" y="590" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="stage3-col4" value="脱敏技术:\n• 数据屏蔽\n• 令牌化\n• 匿名化/假名化" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1380" y="590" width="380" height="58" as="geometry" />
        </mxCell>

        <!-- Stage 4: Data Monitoring -->
        <mxCell id="stage4-shadow" value="" style="rounded=1;fillColor=#E5E7EB;strokeColor=none;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="84" y="686" width="1756" height="140" as="geometry" />
        </mxCell>
        <mxCell id="stage4-bg" value="" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E0E7FF;strokeWidth=2;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="80" y="682" width="1756" height="140" as="geometry" />
        </mxCell>
        <mxCell id="stage4-header" value="" style="rounded=1;fillColor=#0066FF;strokeColor=none;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="80" y="682" width="1756" height="56" as="geometry" />
        </mxCell>
        <mxCell id="stage4-number" value="4" style="ellipse;fillColor=#FFFFFF;strokeColor=none;fontColor=#0066FF;fontSize=32;fontStyle=1;fontFamily=Inter;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="96" y="688" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="stage4-title" value="数据监控" style="text;fontSize=28;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="156" y="688" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="stage4-title-en" value="Data Monitoring" style="text;fontSize=16;fontColor=#E0E7FF;fontFamily=Inter;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="370" y="696" width="220" height="28" as="geometry" />
        </mxCell>

        <mxCell id="stage4-col1" value="访问审计:\n• 数据访问日志\n• 异常访问检测\n• 用户行为分析 (UBA)" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="120" y="754" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="stage4-col2" value="泄露检测:\n• 数据外泄监控\n• 暗网监测\n• 邮件/IM 监控" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="540" y="754" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="stage4-col3" value="合规审计:\n• GDPR / CCPA 报告\n• 数据留存策略\n• 数据删除确认" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="960" y="754" width="380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="stage4-col4" value="响应机制:\n• 泄露事件响应\n• 数据恢复\n• 取证调查" style="text;fontSize=14;fontColor=#1F2937;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1380" y="754" width="380" height="58" as="geometry" />
        </mxCell>


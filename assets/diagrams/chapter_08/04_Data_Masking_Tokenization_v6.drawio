        <mxCell id="type2-number" value="2" style="ellipse;fillColor=#FFFFFF;strokeColor=NONE;fontColor=#0066FF;fontSize=32;fontStyle=1;fontFamily=Inter;" parent="1" vertex="1">
          <mxGeometry x="696" y="188" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="type2-title" value="动态脱敏" style="text;fontSize=24;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=center;" parent="1" vertex="1">
          <mxGeometry x="760" y="188" width="480" height="24" as="geometry" />
        </mxCell>
        <mxCell id="type2-subtitle" value="Dynamic Data Masking (DDM)" style="text;fontSize=14;fontColor=#E0E7FF;fontFamily=Inter;align=center;" parent="1" vertex="1">
          <mxGeometry x="760" y="216" width="480" height="18" as="geometry" />
        </mxCell>
        <mxCell id="type2-content" value="场景&#xa;• 生产环境实时查询&#xa;• Web应用界面展示&#xa;• API响应过滤&#xa;&#xa;特点&#xa;• 按需脱敏 • 基于角色(RBAC)&#xa;• 不修改原始数据&#xa;&#xa;技术: 数据库代理/应用层拦截" style="text;fontSize=14;fontColor=#1A1A1A;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=left;spacingLeft=20;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="696" y="240" width="548" height="172" as="geometry" />
        </mxCell>

        <mxCell id="type1-title" value="静态脱敏" style="text;fontSize=24;fontStyle=1;fontColor=#FFFFFF;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans SC,sans-serif;align=center;" parent="1" vertex="1">
          <mxGeometry x="160" y="188" width="480" height="24" as="geometry" />
